# Contact form → email, via Resend (https://resend.com). Copy to .env.local for local testing and
# add the same three variables in your host's dashboard (e.g. Vercel → Project → Settings →
# Environment Variables) for production.

# Resend → API Keys → Create (permission: "Sending access").
RESEND_API_KEY=

# The inbox that receives messages.
CONTACT_TO_EMAIL=

# Sender. Must be on a domain verified in Resend → Domains (add the DNS records it shows you).
# For a first test without a domain you can use "Portfolio <onboarding@resend.dev>", which only
# delivers to the email address your Resend account was created with.
CONTACT_FROM_EMAIL="Portfolio <contact@itsabubakar.me>"
